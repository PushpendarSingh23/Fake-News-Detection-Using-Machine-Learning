# ==============================================================================
# Environment Configuration Template - AI Fake News Detection System
# Copy this file to .env and set your local environment variables.
# Never commit .env containing real credentials or secrets to version control.
# ==============================================================================

# Application Settings
DEBUG=true
PORT=5000
HOST=127.0.0.1
SECRET_KEY=dev-insecure-secret-key-replace-in-production-32chars-min

# Session Security (set to true in production with HTTPS)
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ai_fake_news
DB_POOL_SIZE=10
